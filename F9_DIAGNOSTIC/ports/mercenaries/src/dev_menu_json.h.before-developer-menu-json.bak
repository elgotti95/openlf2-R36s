#ifndef MERCENARIES_DEV_MENU_JSON_H
#define MERCENARIES_DEV_MENU_JSON_H

/* Small bounded JSON reader for the user-editable F9 configuration.
 * It intentionally supports the JSON subset used by the menu/catalog files:
 * objects, arrays, strings, booleans, numbers and null. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <io.h>

#define DEV_MENU_MAX_PAGES 8
#define DEV_MENU_MAX_DIAGNOSTICS 16
#define DEV_MENU_MAX_JSON_VEHICLES 512
#define DEV_MENU_MAX_JSON_TROOPS 128
#define DEV_MENU_MAX_CHOICES 32
#define DEV_MENU_MAX_WEAPONS 32
#define DEV_MENU_MAX_BUTTONS 24
#define DEV_MENU_MAX_JSON_FILE (4u * 1024u * 1024u)

typedef struct DevMenuPageConfig {
    char id[40];
    char label[96];
    int view;
} DevMenuPageConfig;

typedef struct DevMenuDiagnosticConfig {
    char action[32];
    char label[96];
    int control_id;
} DevMenuDiagnosticConfig;

typedef struct DevMenuChoice {
    char label[96];
    int value;
} DevMenuChoice;

typedef struct DevMenuWeaponConfig {
    char label[96];
    char template_name[96];
    int value;
} DevMenuWeaponConfig;

typedef struct DevMenuButtonConfig {
    char id[40];
    char label[96];
    int control_id;
} DevMenuButtonConfig;

static DevVehicle dev_menu_json_vehicles[DEV_MENU_MAX_JSON_VEHICLES];
static DevVehicle dev_menu_json_troops[DEV_MENU_MAX_JSON_TROOPS];
static unsigned dev_menu_json_vehicle_count;
static unsigned dev_menu_json_troop_count;
static int dev_menu_json_catalogs_loaded;
static int dev_menu_json_loaded;
static char dev_menu_json_root[MAX_PATH];
static char dev_menu_json_vehicle_catalog_relative[160] = "catalogs/vehicles.json";
static char dev_menu_json_troop_catalog_relative[160] = "catalogs/troops.json";
static char dev_menu_json_title[128] = "Mercenaries - Developer tools";
static int dev_menu_json_width = 1040;
static int dev_menu_json_height = 700;
static DevMenuPageConfig dev_menu_pages[DEV_MENU_MAX_PAGES];
static unsigned dev_menu_page_count;
static DevMenuDiagnosticConfig dev_menu_diagnostics[DEV_MENU_MAX_DIAGNOSTICS];
static unsigned dev_menu_diagnostic_count;
static DevMenuChoice dev_menu_crew_modes[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_crew_mode_count;
static DevMenuChoice dev_menu_crew_factions[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_crew_faction_count;
static DevMenuChoice dev_menu_troop_quantities[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_troop_quantity_count;
static DevMenuChoice dev_menu_mission_factions[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_mission_faction_count;
static DevMenuChoice dev_menu_provinces[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_province_count;
static DevMenuChoice dev_menu_relation_factions[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_relation_faction_count;
static DevMenuChoice dev_menu_relation_values[DEV_MENU_MAX_CHOICES];
static unsigned dev_menu_relation_value_count;
static DevMenuWeaponConfig dev_menu_weapons[DEV_MENU_MAX_WEAPONS];
static unsigned dev_menu_weapon_count;
static DevMenuButtonConfig dev_menu_buttons[DEV_MENU_MAX_BUTTONS];
static unsigned dev_menu_button_count;

static const char *dev_json_ws(const char *p)
{
    while (p && *p && isspace((unsigned char)*p)) ++p;
    return p;
}

static const char *dev_json_skip_string(const char *p)
{
    if (!p || *p != '"') return p;
    ++p;
    while (*p) {
        if (*p == '\\') {
            if (p[1]) p += 2;
            else return p + 1;
        } else if (*p == '"') return p + 1;
        else ++p;
    }
    return p;
}

static const char *dev_json_skip_value(const char *p, unsigned depth)
{
    p = dev_json_ws(p);
    if (!p || !*p || depth > 32) return p;
    if (*p == '"') return dev_json_skip_string(p);
    if (*p == '{') {
        ++p;
        for (;;) {
            p = dev_json_ws(p);
            if (*p == '}') return p + 1;
            if (*p != '"') return p;
            p = dev_json_skip_string(p);
            p = dev_json_ws(p);
            if (*p != ':') return p;
            p = dev_json_skip_value(p + 1, depth + 1);
            p = dev_json_ws(p);
            if (*p == ',') { ++p; continue; }
            if (*p == '}') return p + 1;
            return p;
        }
    }
    if (*p == '[') {
        ++p;
        for (;;) {
            p = dev_json_ws(p);
            if (*p == ']') return p + 1;
            const char *next = dev_json_skip_value(p, depth + 1);
            if (next <= p) return p;
            p = dev_json_ws(next);
            if (*p == ',') { ++p; continue; }
            if (*p == ']') return p + 1;
            return p;
        }
    }
    while (*p && *p != ',' && *p != ']' && *p != '}' && !isspace((unsigned char)*p)) ++p;
    return p;
}

static void dev_json_decode_string(const char *p, char *out, size_t capacity)
{
    size_t n = 0;
    if (!out || capacity == 0) return;
    out[0] = 0;
    if (!p || *p != '"') return;
    ++p;
    while (*p && *p != '"' && n + 1 < capacity) {
        unsigned char ch = (unsigned char)*p++;
        if (ch == '\\' && *p) {
            char esc = *p++;
            switch (esc) {
            case '"': ch = '"'; break;
            case '\\': ch = '\\'; break;
            case '/': ch = '/'; break;
            case 'b': ch = '\b'; break;
            case 'f': ch = '\f'; break;
            case 'n': ch = '\n'; break;
            case 'r': ch = '\r'; break;
            case 't': ch = '\t'; break;
            case 'u':
                /* Menu labels are UTF-8. Preserve ASCII escapes and use '?'
                 * for escaped non-ASCII code points rather than corrupt bytes. */
                if (p[0] && p[1] && p[2] && p[3] &&
                    isxdigit((unsigned char)p[0]) && isxdigit((unsigned char)p[1]) &&
                    isxdigit((unsigned char)p[2]) && isxdigit((unsigned char)p[3])) {
                    char hex[5] = { p[0], p[1], p[2], p[3], 0 };
                    unsigned long cp = strtoul(hex, NULL, 16);
                    p += 4;
                    ch = cp <= 0x7Fu ? (unsigned char)cp : (unsigned char)'?';
                } else ch = '?';
                break;
            default: ch = (unsigned char)esc; break;
            }
        }
        out[n++] = (char)ch;
    }
    out[n] = 0;
}

static const char *dev_json_member(const char *object, const char *name)
{
    const char *p = dev_json_ws(object);
    if (!p || *p != '{') return NULL;
    ++p;
    for (;;) {
        char key[128];
        p = dev_json_ws(p);
        if (*p == '}' || !*p) return NULL;
        if (*p != '"') return NULL;
        dev_json_decode_string(p, key, sizeof(key));
        p = dev_json_ws(dev_json_skip_string(p));
        if (*p != ':') return NULL;
        p = dev_json_ws(p + 1);
        if (strcmp(key, name) == 0) return p;
        const char *next = dev_json_skip_value(p, 0);
        if (next <= p) return NULL;
        p = dev_json_ws(next);
        if (*p == ',') { ++p; continue; }
        return NULL;
    }
}

static void dev_json_get_string(const char *object, const char *key, char *out, size_t capacity)
{
    const char *value = dev_json_member(object, key);
    if (value && *value == '"') dev_json_decode_string(value, out, capacity);
    else if (out && capacity) out[0] = 0;
}

static double dev_json_get_number(const char *object, const char *key, double fallback)
{
    const char *value = dev_json_member(object, key);
    if (!value || (!isdigit((unsigned char)*value) && *value != '-' && *value != '+')) return fallback;
    char *end = NULL;
    double result = strtod(value, &end);
    return end == value ? fallback : result;
}

static int dev_json_get_bool(const char *object, const char *key, int fallback)
{
    const char *value = dev_json_member(object, key);
    if (!value) return fallback;
    if (strncmp(value, "true", 4) == 0) return 1;
    if (strncmp(value, "false", 5) == 0) return 0;
    return fallback;
}

static char *dev_json_strdup(const char *text)
{
    size_t length = text ? strlen(text) : 0;
    char *copy = (char *)malloc(length + 1);
    if (!copy) return NULL;
    if (length) memcpy(copy, text, length);
    copy[length] = 0;
    return copy;
}

static int dev_json_read_file(const char *path, char **content)
{
    FILE *file = fopen(path, "rb");
    if (!file) return 0;
    if (fseek(file, 0, SEEK_END) != 0) { fclose(file); return 0; }
    long length = ftell(file);
    if (length <= 0 || (unsigned long)length > DEV_MENU_MAX_JSON_FILE ||
        fseek(file, 0, SEEK_SET) != 0) { fclose(file); return 0; }
    char *data = (char *)malloc((size_t)length + 1);
    if (!data) { fclose(file); return 0; }
    size_t read_count = fread(data, 1, (size_t)length, file);
    fclose(file);
    if (read_count != (size_t)length) { free(data); return 0; }
    data[length] = 0;
    *content = data;
    return 1;
}

static int dev_json_view_code(const char *view)
{
    if (!strcmp(view, "vehicles")) return 0;
    if (!strcmp(view, "missions")) return 1;
    if (!strcmp(view, "troops")) return 2;
    if (!strcmp(view, "relations")) return 3;
    if (!strcmp(view, "filip_vehicles")) return 4;
    if (!strcmp(view, "diagnostics")) return 5;
    return -1;
}

static int dev_json_diagnostic_id(const char *action)
{
    if (!strcmp(action, "bookmark")) return ID_BOOKMARK;
    if (!strcmp(action, "inspect_spawn")) return ID_INSPECT;
    if (!strcmp(action, "freecam_toggle")) return ID_FREECAM;
    if (!strcmp(action, "fps_toggle")) return ID_PERFORMANCE;
    if (!strcmp(action, "untargetable_toggle")) return ID_UNTARGETABLE;
    if (!strcmp(action, "passive_toggle")) return ID_PASSIVE;
    if (!strcmp(action, "boids_spawn")) return ID_BOIDS;
    return 0;
}

static int dev_menu_json_choice_value_valid(const char *key, int value)
{
    if (!strcmp(key, "crew_modes")) return value >= 0 && value <= 2;
    if (!strcmp(key, "crew_factions")) return value >= 0 && value <= 4;
    if (!strcmp(key, "troop_quantities")) return value >= 1 && value <= 12;
    if (!strcmp(key, "mission_factions")) return value >= 0 && value <= 3;
    if (!strcmp(key, "provinces")) return value >= 0 && value <= 1;
    if (!strcmp(key, "relation_factions")) return value >= 0 && value <= 6;
    if (!strcmp(key, "relation_values")) return value >= 0 && value <= 3;
    return 0;
}

static unsigned dev_menu_json_parse_choices(const char *content, const char *key,
                                             DevMenuChoice *out, unsigned capacity)
{
    const char *array = dev_json_member(content, key);
    if (!array || *array != '[') return 0;
    unsigned count = 0;
    const char *p = array + 1;
    while (*p && *dev_json_ws(p) != ']' && count < capacity) {
        p = dev_json_ws(p);
        if (*p == ',') { ++p; continue; }
        if (*p != '{') break;
        const char *end = dev_json_skip_value(p, 0);
        DevMenuChoice item = {0};
        dev_json_get_string(p, "label", item.label, sizeof(item.label));
        item.value = (int)dev_json_get_number(p, "value", (double)count);
        int duplicate = 0;
        for (unsigned i = 0; i < count; ++i) if (out[i].value == item.value) duplicate = 1;
        if (item.label[0] && !duplicate && dev_menu_json_choice_value_valid(key, item.value)) out[count++] = item;
        if (end <= p) break;
        p = end;
    }
    return count;
}

static unsigned dev_menu_json_parse_weapons(const char *content)
{
    const char *array = dev_json_member(content, "weapons");
    if (!array || *array != '[') return 0;
    unsigned count = 0;
    int has_default_loadout = 0;
    const char *p = array + 1;
    while (*p && *dev_json_ws(p) != ']' && count < DEV_MENU_MAX_WEAPONS) {
        p = dev_json_ws(p);
        if (*p == ',') { ++p; continue; }
        if (*p != '{') break;
        const char *end = dev_json_skip_value(p, 0);
        DevMenuWeaponConfig item = {0};
        dev_json_get_string(p, "label", item.label, sizeof(item.label));
        dev_json_get_string(p, "template", item.template_name, sizeof(item.template_name));
        item.value = (int)dev_json_get_number(p, "value", (double)count);
        int duplicate = 0;
        for (unsigned i = 0; i < count; ++i) if (dev_menu_weapons[i].value == item.value) duplicate = 1;
        if (item.label[0] && item.value >= 0 && item.value <= 31 && !duplicate) {
            dev_menu_weapons[count++] = item;
            if (item.value == 0 && !item.template_name[0]) has_default_loadout = 1;
        }
        if (end <= p) break;
        p = end;
    }
    return has_default_loadout ? count : 0;
}

static DevMenuChoice *dev_menu_json_choice_array(const char *key, unsigned *count)
{
    if (!strcmp(key, "crew_modes")) { *count = dev_menu_crew_mode_count; return dev_menu_crew_modes; }
    if (!strcmp(key, "crew_factions")) { *count = dev_menu_crew_faction_count; return dev_menu_crew_factions; }
    if (!strcmp(key, "troop_quantities")) { *count = dev_menu_troop_quantity_count; return dev_menu_troop_quantities; }
    if (!strcmp(key, "mission_factions")) { *count = dev_menu_mission_faction_count; return dev_menu_mission_factions; }
    if (!strcmp(key, "provinces")) { *count = dev_menu_province_count; return dev_menu_provinces; }
    if (!strcmp(key, "relation_factions")) { *count = dev_menu_relation_faction_count; return dev_menu_relation_factions; }
    if (!strcmp(key, "relation_values")) { *count = dev_menu_relation_value_count; return dev_menu_relation_values; }
    *count = 0;
    return NULL;
}

static void dev_menu_json_fill_combo(HWND combo, const char *key)
{
    unsigned count = 0;
    DevMenuChoice *items = dev_menu_json_choice_array(key, &count);
    SendMessageA(combo, CB_RESETCONTENT, 0, 0);
    for (unsigned i = 0; i < count; ++i) {
        LRESULT row = SendMessageA(combo, CB_ADDSTRING, 0, (LPARAM)items[i].label);
        if (row != CB_ERR && row != CB_ERRSPACE)
            SendMessageA(combo, CB_SETITEMDATA, (WPARAM)row, (LPARAM)items[i].value);
    }
    if (count) SendMessageA(combo, CB_SETCURSEL, 0, 0);
}

static int dev_menu_json_combo_value(HWND combo)
{
    LRESULT selected = SendMessageA(combo, CB_GETCURSEL, 0, 0);
    if (selected == CB_ERR) return -1;
    LRESULT value = SendMessageA(combo, CB_GETITEMDATA, (WPARAM)selected, 0);
    return value == CB_ERR ? (int)selected : (int)value;
}

static void dev_menu_json_select_combo_value(HWND combo, int value)
{
    LRESULT count = SendMessageA(combo, CB_GETCOUNT, 0, 0);
    for (LRESULT i = 0; i < count; ++i) {
        LRESULT item = SendMessageA(combo, CB_GETITEMDATA, (WPARAM)i, 0);
        if (item == value) { SendMessageA(combo, CB_SETCURSEL, (WPARAM)i, 0); return; }
    }
    if (count > 0) SendMessageA(combo, CB_SETCURSEL, 0, 0);
}

static unsigned dev_menu_json_weapon_count(void)
{
    return dev_menu_weapon_count ? dev_menu_weapon_count : (unsigned)DEV_WEAPON_COUNT;
}
static const char *dev_menu_json_weapon_row_name(unsigned row)
{
    if (dev_menu_weapon_count) return row < dev_menu_weapon_count ? dev_menu_weapons[row].label : "";
    return row < DEV_WEAPON_COUNT ? dev_weapons[row].name : "";
}
static unsigned dev_menu_json_weapon_row_value(unsigned row)
{
    if (dev_menu_weapon_count) return row < dev_menu_weapon_count && dev_menu_weapons[row].value >= 0 ? (unsigned)dev_menu_weapons[row].value : 0u;
    return row < DEV_WEAPON_COUNT ? row : 0u;
}
static const char *dev_menu_json_weapon_name(unsigned value)
{
    if (dev_menu_weapon_count) {
        for (unsigned i = 0; i < dev_menu_weapon_count; ++i)
            if (dev_menu_weapons[i].value == (int)value) return dev_menu_weapons[i].label;
        return "Unknown weapon";
    }
    return value < DEV_WEAPON_COUNT ? dev_weapons[value].name : "Unknown weapon";
}
static const char *dev_menu_json_weapon_template(unsigned value)
{
    if (dev_menu_weapon_count) {
        for (unsigned i = 0; i < dev_menu_weapon_count; ++i)
            if (dev_menu_weapons[i].value == (int)value)
                return dev_menu_weapons[i].template_name[0] ? dev_menu_weapons[i].template_name : NULL;
        return NULL;
    }
    return value < DEV_WEAPON_COUNT ? dev_weapons[value].template_name : NULL;
}

static void dev_menu_json_load_choice_arrays(const char *content)
{
    unsigned n;
    n = dev_menu_json_parse_choices(content, "crew_modes", dev_menu_crew_modes, DEV_MENU_MAX_CHOICES); if (n) dev_menu_crew_mode_count = n;
    n = dev_menu_json_parse_choices(content, "crew_factions", dev_menu_crew_factions, DEV_MENU_MAX_CHOICES); if (n) dev_menu_crew_faction_count = n;
    n = dev_menu_json_parse_choices(content, "troop_quantities", dev_menu_troop_quantities, DEV_MENU_MAX_CHOICES); if (n) dev_menu_troop_quantity_count = n;
    n = dev_menu_json_parse_choices(content, "mission_factions", dev_menu_mission_factions, DEV_MENU_MAX_CHOICES); if (n) dev_menu_mission_faction_count = n;
    n = dev_menu_json_parse_choices(content, "provinces", dev_menu_provinces, DEV_MENU_MAX_CHOICES); if (n) dev_menu_province_count = n;
    n = dev_menu_json_parse_choices(content, "relation_factions", dev_menu_relation_factions, DEV_MENU_MAX_CHOICES); if (n) dev_menu_relation_faction_count = n;
    n = dev_menu_json_parse_choices(content, "relation_values", dev_menu_relation_values, DEV_MENU_MAX_CHOICES); if (n) dev_menu_relation_value_count = n;
    n = dev_menu_json_parse_weapons(content); if (n) dev_menu_weapon_count = n;
}

static int dev_menu_button_id(const char *id)
{
    if (!strcmp(id, "spawn")) return ID_SPAWN;
    if (!strcmp(id, "close")) return ID_CLOSE;
    if (!strcmp(id, "close_after_spawn")) return ID_AUTOCLOSE;
    if (!strcmp(id, "mission_start")) return ID_MISSION_START;
    if (!strcmp(id, "province_travel")) return ID_TRAVEL;
    if (!strcmp(id, "relation_apply")) return ID_RELATION_APPLY;
    return 0;
}

static void dev_menu_json_apply_button_labels(HWND panel)
{
    for (unsigned i = 0; i < dev_menu_button_count; ++i) {
        HWND control = GetDlgItem(panel, dev_menu_buttons[i].control_id);
        if (control) SetWindowTextA(control, dev_menu_buttons[i].label);
    }
}

static void dev_menu_json_defaults(void)
{
    static const struct { const char *id, *label, *view; } pages[] = {
        {"vehicles", "Vehicle Spawner", "vehicles"},
        {"filip_vehicles", "Filip - Vehicles", "filip_vehicles"},
        {"troops", "Troops", "troops"},
        {"missions", "Missions", "missions"},
        {"relations", "Faction Relations", "relations"},
        {"diagnostics", "Diagnostics", "diagnostics"}
    };
    static const struct { const char *action, *label; int id; } diagnostics[] = {
        {"bookmark", "Save diagnostic bookmark", ID_BOOKMARK},
        {"inspect_spawn", "Inspect last spawned actor", ID_INSPECT},
        {"freecam_toggle", "Free Camera (F11)", ID_FREECAM},
        {"fps_toggle", "FPS / Frametime overlay", ID_PERFORMANCE},
        {"untargetable_toggle", "Player untargetable", ID_UNTARGETABLE},
        {"passive_toggle", "Passive Mode", ID_PASSIVE},
        {"boids_spawn", "Spawn Boids Simulation", ID_BOIDS}
    };
    dev_menu_page_count = 0;
    for (unsigned i = 0; i < sizeof(pages) / sizeof(pages[0]); ++i) {
        DevMenuPageConfig *page = &dev_menu_pages[dev_menu_page_count++];
        strcpy_s(page->id, sizeof(page->id), pages[i].id);
        strcpy_s(page->label, sizeof(page->label), pages[i].label);
        page->view = dev_json_view_code(pages[i].view);
    }
    dev_menu_diagnostic_count = 0;
    for (unsigned i = 0; i < sizeof(diagnostics) / sizeof(diagnostics[0]); ++i) {
        DevMenuDiagnosticConfig *item = &dev_menu_diagnostics[dev_menu_diagnostic_count++];
        strcpy_s(item->action, sizeof(item->action), diagnostics[i].action);
        strcpy_s(item->label, sizeof(item->label), diagnostics[i].label);
        item->control_id = diagnostics[i].id;
    }
    static const struct { const char *id, *label; int control_id; } buttons[] = {
        {"spawn","Spawn",ID_SPAWN},{"close","Close",ID_CLOSE},
        {"close_after_spawn","Close after spawning",ID_AUTOCLOSE},
        {"mission_start","Start mission",ID_MISSION_START},
        {"province_travel","Travel",ID_TRAVEL},{"relation_apply","Apply",ID_RELATION_APPLY}
    };
    dev_menu_button_count = 0;
    for (unsigned i = 0; i < sizeof(buttons)/sizeof(buttons[0]); ++i) {
        DevMenuButtonConfig *item = &dev_menu_buttons[dev_menu_button_count++];
        strcpy_s(item->id,sizeof(item->id),buttons[i].id);
        strcpy_s(item->label,sizeof(item->label),buttons[i].label);
        item->control_id = buttons[i].control_id;
    }

    static const struct { const char *label; int value; } crew_modes[] = {
        {"Empty vehicle",0},{"Driver / pilot only",1},{"Full crew and passengers",2}
    };
    static const struct { const char *label; int value; } crew_factions[] = {
        {"Crew: Allied Nations",0},{"Crew: Chinese",1},{"Crew: Russian Mafia",2},{"Crew: North Korean",3},{"Crew: South Korean",4}
    };
    static const struct { const char *label; int value; } quantities[] = {
        {"1 soldier",1},{"4 soldiers",4},{"8 soldiers",8},{"12 soldiers",12}
    };
    static const struct { const char *label; int value; } mission_factions[] = {
        {"Allied Nations",0},{"Chinese",1},{"Russian Mafia",2},{"South Korean",3}
    };
    static const struct { const char *label; int value; } provinces[] = {
        {"Southern Province",0},{"Northern Province",1}
    };
    static const struct { const char *label; int value; } relations[] = {
        {"Player / Mercenaries",0},{"North Korean",1},{"South Korean",2},{"Russian Mafia",3},{"Chinese",4},{"Allied Nations",5},{"Civilian",6}
    };
    static const struct { const char *label; int value; } relation_values[] = {
        {"Hostile",0},{"Unfriendly",1},{"Neutral",2},{"Friendly",3}
    };
    dev_menu_crew_mode_count = (unsigned)(sizeof(crew_modes)/sizeof(crew_modes[0]));
    for(unsigned i=0;i<dev_menu_crew_mode_count;i++){strcpy_s(dev_menu_crew_modes[i].label,sizeof(dev_menu_crew_modes[i].label),crew_modes[i].label);dev_menu_crew_modes[i].value=crew_modes[i].value;}
    dev_menu_crew_faction_count = (unsigned)(sizeof(crew_factions)/sizeof(crew_factions[0]));
    for(unsigned i=0;i<dev_menu_crew_faction_count;i++){strcpy_s(dev_menu_crew_factions[i].label,sizeof(dev_menu_crew_factions[i].label),crew_factions[i].label);dev_menu_crew_factions[i].value=crew_factions[i].value;}
    dev_menu_troop_quantity_count = (unsigned)(sizeof(quantities)/sizeof(quantities[0]));
    for(unsigned i=0;i<dev_menu_troop_quantity_count;i++){strcpy_s(dev_menu_troop_quantities[i].label,sizeof(dev_menu_troop_quantities[i].label),quantities[i].label);dev_menu_troop_quantities[i].value=quantities[i].value;}
    dev_menu_mission_faction_count = (unsigned)(sizeof(mission_factions)/sizeof(mission_factions[0]));
    for(unsigned i=0;i<dev_menu_mission_faction_count;i++){strcpy_s(dev_menu_mission_factions[i].label,sizeof(dev_menu_mission_factions[i].label),mission_factions[i].label);dev_menu_mission_factions[i].value=mission_factions[i].value;}
    dev_menu_province_count = (unsigned)(sizeof(provinces)/sizeof(provinces[0]));
    for(unsigned i=0;i<dev_menu_province_count;i++){strcpy_s(dev_menu_provinces[i].label,sizeof(dev_menu_provinces[i].label),provinces[i].label);dev_menu_provinces[i].value=provinces[i].value;}
    dev_menu_relation_faction_count = (unsigned)(sizeof(relations)/sizeof(relations[0]));
    for(unsigned i=0;i<dev_menu_relation_faction_count;i++){strcpy_s(dev_menu_relation_factions[i].label,sizeof(dev_menu_relation_factions[i].label),relations[i].label);dev_menu_relation_factions[i].value=relations[i].value;}
    dev_menu_relation_value_count = (unsigned)(sizeof(relation_values)/sizeof(relation_values[0]));
    for(unsigned i=0;i<dev_menu_relation_value_count;i++){strcpy_s(dev_menu_relation_values[i].label,sizeof(dev_menu_relation_values[i].label),relation_values[i].label);dev_menu_relation_values[i].value=relation_values[i].value;}
}

static void dev_menu_json_find_root(void)
{
    char override[MAX_PATH];
    DWORD override_length = GetEnvironmentVariableA("MERCENARIES_DEVELOPER_MENU_ROOT", override, MAX_PATH);
    if (override_length && override_length < MAX_PATH) {
        strcpy_s(dev_menu_json_root, sizeof(dev_menu_json_root), override);
        return;
    }
    char executable[MAX_PATH];
    DWORD length = GetModuleFileNameA(NULL, executable, MAX_PATH);
    if (!length || length >= MAX_PATH) return;
    char *slash = strrchr(executable, '\\');
    if (!slash) return;
    slash[1] = 0;
    snprintf(dev_menu_json_root, sizeof(dev_menu_json_root), "%sgame_files\\mercenaries-retail\\developer-menu", executable);
    if (_access(dev_menu_json_root, 0) != 0)
        snprintf(dev_menu_json_root, sizeof(dev_menu_json_root), "%sdeveloper-menu", executable);
}

static int dev_menu_json_safe_relative_path(const char *path)
{
    if (!path || !*path || path[0] == '/' || path[0] == '\\' || strchr(path, ':') || strstr(path, "..")) return 0;
    for (const unsigned char *p = (const unsigned char *)path; *p; ++p)
        if (!(isalnum(*p) || *p == '_' || *p == '-' || *p == '.' || *p == '/' || *p == '\\')) return 0;
    return 1;
}

static void dev_menu_json_load_gui(void)
{
    char path[MAX_PATH];
    char *content = NULL;
    snprintf(path, sizeof(path), "%s\\gui.json", dev_menu_json_root);
    if (!dev_json_read_file(path, &content)) return;

    const char *window = dev_json_member(content, "window");
    if (window) {
        char title[128];
        dev_json_get_string(window, "title", title, sizeof(title));
        if (title[0]) strcpy_s(dev_menu_json_title, sizeof(dev_menu_json_title), title);
        int width = (int)dev_json_get_number(window, "width", dev_menu_json_width);
        int height = (int)dev_json_get_number(window, "height", dev_menu_json_height);
        if (width >= 860 && width <= 1600) dev_menu_json_width = width;
        if (height >= 620 && height <= 1100) dev_menu_json_height = height;
    }

    const char *catalogs = dev_json_member(content, "catalogs");
    if (catalogs && *catalogs == '{') {
        char relative[160];
        dev_json_get_string(catalogs, "vehicles", relative, sizeof(relative));
        if (dev_menu_json_safe_relative_path(relative)) strcpy_s(dev_menu_json_vehicle_catalog_relative, sizeof(dev_menu_json_vehicle_catalog_relative), relative);
        dev_json_get_string(catalogs, "troops", relative, sizeof(relative));
        if (dev_menu_json_safe_relative_path(relative)) strcpy_s(dev_menu_json_troop_catalog_relative, sizeof(dev_menu_json_troop_catalog_relative), relative);
    }

    const char *pages = dev_json_member(content, "pages");
    if (pages && *pages == '[') {
        dev_menu_page_count = 0;
        const char *p = pages + 1;
        while (*p && *dev_json_ws(p) != ']' && dev_menu_page_count < DEV_MENU_MAX_PAGES) {
            p = dev_json_ws(p);
            if (*p == ',') { ++p; continue; }
            if (*p != '{') break;
            const char *end = dev_json_skip_value(p, 0);
            DevMenuPageConfig item = {0};
            char view[48];
            dev_json_get_string(p, "id", item.id, sizeof(item.id));
            dev_json_get_string(p, "label", item.label, sizeof(item.label));
            dev_json_get_string(p, "view", view, sizeof(view));
            item.view = dev_json_view_code(view);
            if (item.id[0] && item.label[0] && item.view >= 0)
                dev_menu_pages[dev_menu_page_count++] = item;
            if (end <= p) break;
            p = end;
        }
    }

    dev_menu_json_load_choice_arrays(content);

    const char *buttons = dev_json_member(content, "buttons");
    if (buttons && *buttons == '[') {
        dev_menu_button_count = 0;
        const char *p = buttons + 1;
        while (*p && *dev_json_ws(p) != ']' && dev_menu_button_count < DEV_MENU_MAX_BUTTONS) {
            p = dev_json_ws(p);
            if (*p == ',') { ++p; continue; }
            if (*p != '{') break;
            const char *end = dev_json_skip_value(p, 0);
            DevMenuButtonConfig item = {0};
            dev_json_get_string(p, "id", item.id, sizeof(item.id));
            dev_json_get_string(p, "label", item.label, sizeof(item.label));
            item.control_id = dev_menu_button_id(item.id);
            if (item.control_id && item.label[0]) dev_menu_buttons[dev_menu_button_count++] = item;
            if (end <= p) break;
            p = end;
        }
    }

    const char *diagnostics = dev_json_member(content, "diagnostics");
    if (diagnostics && *diagnostics == '[') {
        dev_menu_diagnostic_count = 0;
        const char *p = diagnostics + 1;
        while (*p && *dev_json_ws(p) != ']' && dev_menu_diagnostic_count < DEV_MENU_MAX_DIAGNOSTICS) {
            p = dev_json_ws(p);
            if (*p == ',') { ++p; continue; }
            if (*p != '{') break;
            const char *end = dev_json_skip_value(p, 0);
            DevMenuDiagnosticConfig item = {0};
            dev_json_get_string(p, "action", item.action, sizeof(item.action));
            dev_json_get_string(p, "label", item.label, sizeof(item.label));
            item.control_id = dev_json_diagnostic_id(item.action);
            if (item.control_id && item.label[0])
                dev_menu_diagnostics[dev_menu_diagnostic_count++] = item;
            if (end <= p) break;
            p = end;
        }
    }
    free(content);
    if (!dev_menu_page_count) dev_menu_json_defaults();
}

static void dev_menu_json_parse_vehicle(const char *object, DevVehicle *vehicle)
{
    char text[256], source[128], catalog[40];
    memset(vehicle, 0, sizeof(*vehicle));
    dev_json_get_string(object, "name", text, sizeof(text)); vehicle->name = dev_json_strdup(text);
    dev_json_get_string(object, "template", text, sizeof(text)); vehicle->template_name = dev_json_strdup(text);
    dev_json_get_string(object, "faction", text, sizeof(text)); vehicle->faction = dev_json_strdup(text);
    dev_json_get_string(object, "kind", text, sizeof(text)); vehicle->kind = dev_json_strdup(text);
    dev_json_get_string(object, "asset_list", text, sizeof(text));
    if (!text[0]) {
        dev_json_get_string(object, "source", source, sizeof(source));
        if (!strncmp(source, "template_vehicles", 17)) {
            strcpy_s(text, sizeof(text), source);
            char *dot = strrchr(text, '.'); if (dot) *dot = 0;
        }
    }
    vehicle->asset_list = dev_json_strdup(text);
    vehicle->template_hash = (uint32_t)dev_json_get_number(object, "template_hash", 0);
    vehicle->model_hash = (uint32_t)dev_json_get_number(object, "model_hash", 0);
    vehicle->radius = (float)dev_json_get_number(object, "radius", 0);
    vehicle->bottom = (float)dev_json_get_number(object, "bottom", 0);
    vehicle->height = (float)dev_json_get_number(object, "height", 0);
    vehicle->half_width = (float)dev_json_get_number(object, "half_width", 0);
    vehicle->half_length = (float)dev_json_get_number(object, "half_length", 0);
    vehicle->spawnable = dev_json_get_bool(object, "spawnable", 0);
    vehicle->restricted = dev_json_get_bool(object, "disabled_debug_spawn", 0);
    dev_json_get_string(object, "catalog", catalog, sizeof(catalog));
    vehicle->catalog = !strcmp(catalog, "filip") ? 1u : 0u;
}

static int dev_menu_json_load_catalog_file(const char *path)
{
    char *content = NULL;
    if (!dev_json_read_file(path, &content)) return 0;
    const char *array = dev_json_member(content, "vehicles");
    if (!array || *array != '[') { free(content); return 0; }
    const char *p = array + 1;
    while (*p && *dev_json_ws(p) != ']' && dev_menu_json_vehicle_count < DEV_MENU_MAX_JSON_VEHICLES) {
        p = dev_json_ws(p);
        if (*p == ',') { ++p; continue; }
        if (*p != '{') break;
        const char *end = dev_json_skip_value(p, 0);
        dev_menu_json_parse_vehicle(p, &dev_menu_json_vehicles[dev_menu_json_vehicle_count]);
        if (dev_menu_json_vehicles[dev_menu_json_vehicle_count].name &&
            dev_menu_json_vehicles[dev_menu_json_vehicle_count].template_name)
            ++dev_menu_json_vehicle_count;
        if (end <= p) break;
        p = end;
    }
    free(content);
    return dev_menu_json_vehicle_count > 0;
}

static int dev_menu_json_load_troops_file(const char *path)
{
    char *content = NULL;
    if (!dev_json_read_file(path, &content)) return 0;
    const char *array = dev_json_member(content, "troops");
    if (!array || *array != '[') { free(content); return 0; }
    const char *p = array + 1;
    while (*p && *dev_json_ws(p) != ']' && dev_menu_json_troop_count < DEV_MENU_MAX_JSON_TROOPS) {
        p = dev_json_ws(p);
        if (*p == ',') { ++p; continue; }
        if (*p != '{') break;
        const char *end = dev_json_skip_value(p, 0);
        dev_menu_json_parse_vehicle(p, &dev_menu_json_troops[dev_menu_json_troop_count]);
        if (!dev_menu_json_troops[dev_menu_json_troop_count].asset_list ||
            !dev_menu_json_troops[dev_menu_json_troop_count].asset_list[0])
            dev_menu_json_troops[dev_menu_json_troop_count].asset_list = "template_humans";
        if (dev_menu_json_troops[dev_menu_json_troop_count].name &&
            dev_menu_json_troops[dev_menu_json_troop_count].template_name)
            ++dev_menu_json_troop_count;
        if (end <= p) break;
        p = end;
    }
    free(content);
    return dev_menu_json_troop_count > 0;
}

static void dev_menu_json_load(void)
{
    if (dev_menu_json_loaded) return;
    dev_menu_json_loaded = 1;
    dev_menu_json_defaults();
    dev_menu_json_find_root();
    dev_menu_json_load_gui();

    char vehicles_path[MAX_PATH], troops_path[MAX_PATH];
    snprintf(vehicles_path, sizeof(vehicles_path), "%s\\%s", dev_menu_json_root, dev_menu_json_vehicle_catalog_relative);
    snprintf(troops_path, sizeof(troops_path), "%s\\%s", dev_menu_json_root, dev_menu_json_troop_catalog_relative);
    dev_menu_json_vehicle_count = 0;
    dev_menu_json_troop_count = 0;
    if (dev_menu_json_load_catalog_file(vehicles_path) && dev_menu_json_load_troops_file(troops_path))
        dev_menu_json_catalogs_loaded = 1;
    else {
        /* Keep the compile-time catalog as a safe fallback if a user deletes
         * or damages an external JSON file. */
        dev_menu_json_vehicle_count = 0;
        dev_menu_json_troop_count = 0;
        dev_menu_json_catalogs_loaded = 0;
    }
}

static unsigned dev_menu_page_count_get(void) { return dev_menu_page_count; }
static int dev_menu_page_view(unsigned index) { return index < dev_menu_page_count ? dev_menu_pages[index].view : -1; }
static const char *dev_menu_page_label(int view)
{
    for (unsigned i = 0; i < dev_menu_page_count; ++i)
        if (dev_menu_pages[i].view == view) return dev_menu_pages[i].label;
    return "Developer tools";
}
static unsigned dev_menu_diagnostic_count_get(void) { return dev_menu_diagnostic_count; }
static int dev_menu_diagnostic_control(unsigned index) { return index < dev_menu_diagnostic_count ? dev_menu_diagnostics[index].control_id : 0; }
static const char *dev_menu_diagnostic_label(unsigned index) { return index < dev_menu_diagnostic_count ? dev_menu_diagnostics[index].label : ""; }
static unsigned dev_menu_json_panel_width(void) { return (unsigned)dev_menu_json_width; }
static unsigned dev_menu_json_panel_height(void) { return (unsigned)dev_menu_json_height; }
static const char *dev_menu_json_window_title(void) { return dev_menu_json_title; }

#endif
