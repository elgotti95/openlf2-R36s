#!/usr/bin/env python3
"""Validate debug-generated entry point and add only truly missing retail-link stubs."""
from __future__ import annotations

import argparse
import json
import re
from pathlib import Path

SYMBOL_RE = re.compile(r"\b(sub_[0-9A-Fa-f]{8})\b")

# Guest recomp functions are emitted as ordinary C function definitions. This
# deliberately matches a function BODY (opening brace), never a header prototype.
FUNCTION_DEFINITION_RE = re.compile(
    r"(?m)^[ \t]*(?:(?:static|inline|__forceinline|extern)\s+)*"
    r"(?:[A-Za-z_]\w*(?:\s+|\s*\*)+)+"
    r"(sub_[0-9A-Fa-f]{8})\s*\([^;{}]*\)\s*\{"
)


def mask_comments_and_literals(text: str) -> str:
    """Mask comments and C string/char literals while preserving offsets/newlines."""
    out = list(text)
    i = 0
    state = "code"
    escaped = False
    while i < len(text):
        ch = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if state == "code":
            if ch == "/" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "line"
                continue
            if ch == "/" and nxt == "*":
                out[i] = out[i + 1] = " "
                i += 2
                state = "block"
                continue
            if ch == '"':
                out[i] = " "
                state = "string"
            elif ch == "'":
                out[i] = " "
                state = "char"
        elif state == "line":
            if ch == "\n":
                state = "code"
            else:
                out[i] = " "
        elif state == "block":
            if ch == "*" and nxt == "/":
                out[i] = out[i + 1] = " "
                i += 2
                state = "code"
                continue
            if ch != "\n":
                out[i] = " "
        else:  # string or char literal
            if ch != "\n":
                out[i] = " "
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif (state == "string" and ch == '"') or (state == "char" and ch == "'"):
                state = "code"
        i += 1
    return "".join(out)


def function_definitions(text: str) -> set[str]:
    return set(FUNCTION_DEFINITION_RE.findall(mask_comments_and_literals(text)))


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo-root", required=True, type=Path)
    parser.add_argument("--xbe-json", required=True, type=Path)
    parser.add_argument("--generated-root", required=True, type=Path)
    args = parser.parse_args()

    metadata = json.loads(args.xbe_json.read_text(encoding="utf-8"))
    if metadata.get("type") != "debug":
        raise SystemExit("The debug generated-code validator received a non-debug XBE.")
    entry = int(str(metadata["entry_point"]), 16)
    generic = f"sub_{entry:08X}"
    public = "xbe_entry_point"

    header = args.generated_root / "recomp_funcs.h"
    dispatch = args.generated_root / "recomp_dispatch.c"
    if not header.is_file() or not dispatch.is_file():
        raise SystemExit("Generated function header or dispatch table is missing.")

    generated_files = list(args.generated_root.glob("recomp_*.c")) + list(args.generated_root.glob("*.h"))
    if not generated_files:
        raise SystemExit("No generated C/header files were found.")
    header_text = header.read_text(encoding="utf-8", errors="replace")
    dispatch_text = dispatch.read_text(encoding="utf-8", errors="replace")
    if public not in header_text and generic not in header_text:
        raise SystemExit(f"Debug entry function {generic} was not emitted into recomp_funcs.h.")
    if public not in dispatch_text and generic not in dispatch_text:
        raise SystemExit(f"Debug entry function {generic} was not emitted into recomp_dispatch.c.")

    # Normalize the entry symbol one file at a time. Avoid loading the entire
    # multi-megabyte generated tree into one buffer. This is safe to repeat.
    for path in generated_files:
        text = path.read_text(encoding="utf-8", errors="replace")
        if generic in text:
            path.write_text(text.replace(generic, public), encoding="utf-8", newline="")
    header_text = header.read_text(encoding="utf-8", errors="replace")
    dispatch_text = dispatch.read_text(encoding="utf-8", errors="replace")
    if public not in header_text:
        raise SystemExit("xbe_entry_point is missing from recomp_funcs.h after normalization.")
    if public not in dispatch_text:
        raise SystemExit("xbe_entry_point is missing from the debug dispatch table.")

    source_root = args.repo_root / "ports" / "mercenaries" / "src"
    source_files = [
        path for suffix in ("*.c", "*.cpp", "*.h")
        for path in source_root.rglob(suffix)
        if args.generated_root not in path.parents
    ]
    source_texts = [path.read_text(encoding="utf-8", errors="replace") for path in source_files]
    source_code = "\n".join(mask_comments_and_literals(value) for value in source_texts)
    referenced = set(SYMBOL_RE.findall(source_code))
    local_definitions = function_definitions("\n".join(source_texts))

    # CRITICAL: declarations in recomp_funcs.h do NOT prove a function body
    # exists. The previous implementation incorrectly subtracted every header
    # prototype from the missing set, hiding exactly the link failures now seen.
    # Only scan generated C implementation files for actual function bodies.
    generated_c_files = list(args.generated_root.glob("recomp_*.c"))
    stub_path = args.generated_root / "recomp_debug_retail_compat_stubs.c"
    generated_definitions: set[str] = set()
    for path in generated_c_files:
        if path.resolve() == stub_path.resolve():
            continue  # Recompute our own file; do not let stale stubs mask changes.
        generated_definitions.update(
            function_definitions(path.read_text(encoding="utf-8", errors="replace"))
        )

    missing = sorted(referenced - local_definitions - generated_definitions)
    if missing:
        lines = [
            "/* Debug-XBE compatibility fallbacks for retail-only guest references.",
            " * These functions were referenced by maintained port code but had no",
            " * implementation in the debug XBE generated C. They are link-only",
            " * fallbacks; they do not recreate the original retail functionality. */",
            '#include "recomp_types.h"',
            "#include <stdint.h>",
            "extern uint32_t g_esp;",
            "",
        ]
        for name in missing:
            lines.append(f"void {name}(void) {{ g_esp += 4u; }}")
        stub_path.write_text("\n".join(lines) + "\n", encoding="utf-8", newline="")

        emitted = function_definitions(stub_path.read_text(encoding="utf-8"))
        still_missing = sorted(set(missing) - emitted)
        if still_missing:
            raise SystemExit("Failed to emit compatibility definitions: " + ", ".join(still_missing))
        print(f"[INFO] Added {len(missing)} link-only compatibility stubs for retail-only references.")
        print("[INFO] Stubbed symbols: " + ", ".join(missing))
    elif stub_path.exists():
        stub_path.unlink()
        print("[INFO] Removed obsolete debug retail compatibility stub file.")
    else:
        print("[OK] No missing retail-only function definitions were found.")

    print(f"[OK] Debug entry point 0x{entry:08X} is exported as xbe_entry_point.")
    print("[OK] Retail Patch-Generated.py was intentionally not run on the debug XBE.")


if __name__ == "__main__":
    main()
