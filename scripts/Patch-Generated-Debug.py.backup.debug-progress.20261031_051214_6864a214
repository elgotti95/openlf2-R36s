#!/usr/bin/env python3
"""Validate debug entry point and add only truly missing retail-link stubs.

This version avoids the previous character-by-character comment masker over
multi-million-line generated C files. It scans files with compiled regexes,
only searches generated C for symbols actually referenced by maintained code,
and reports progress so a large tree does not look frozen.
"""
from __future__ import annotations

import argparse
import json
import re
from pathlib import Path

SYMBOL_RE = re.compile(r"\b(sub_[0-9A-Fa-f]{8})\b")

# The regular expression engine performs the lexical scan in native code. The
# callback blanks comments/literals while retaining newlines and offsets.
LEXICAL_TOKEN_RE = re.compile(
    r'//[^\r\n]*|/\*.*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'',
    re.DOTALL,
)
NON_NEWLINE_RE = re.compile(r"[^\r\n]")

FUNCTION_DEFINITION_PREFIX = (
    r"(?m)^[ \t]*(?:(?:static|inline|__forceinline|extern)\s+)*"
    r"(?:[A-Za-z_]\w*(?:\s+|\s*\*)+)+"
)
FUNCTION_DEFINITION_SUFFIX = r"\s*\([^;{}]*\)\s*\{"


def mask_comments_and_literals(text: str) -> str:
    """Mask C comments and literals without allocating one Python item/char."""
    return LEXICAL_TOKEN_RE.sub(
        lambda match: NON_NEWLINE_RE.sub(" ", match.group(0)), text
    )


def definition_pattern(symbols: set[str]) -> re.Pattern[str] | None:
    if not symbols:
        return None
    alternatives = "|".join(re.escape(symbol) for symbol in sorted(symbols))
    return re.compile(
        FUNCTION_DEFINITION_PREFIX + r"(" + alternatives + r")" +
        FUNCTION_DEFINITION_SUFFIX
    )


def function_definitions(text: str, pattern: re.Pattern[str] | None = None) -> set[str]:
    masked = mask_comments_and_literals(text)
    if pattern is None:
        pattern = re.compile(
            FUNCTION_DEFINITION_PREFIX + r"(sub_[0-9A-Fa-f]{8})" +
            FUNCTION_DEFINITION_SUFFIX
        )
    return set(pattern.findall(masked))


def read_text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo-root", required=True, type=Path)
    parser.add_argument("--xbe-json", required=True, type=Path)
    parser.add_argument("--generated-root", required=True, type=Path)
    args = parser.parse_args()

    repo_root = args.repo_root.resolve()
    generated_root = args.generated_root.resolve()
    metadata = json.loads(args.xbe_json.read_text(encoding="utf-8"))
    if metadata.get("type") != "debug":
        raise SystemExit("The debug generated-code validator received a non-debug XBE.")
    entry = int(str(metadata["entry_point"]), 16)
    generic = f"sub_{entry:08X}"
    public = "xbe_entry_point"

    header = generated_root / "recomp_funcs.h"
    dispatch = generated_root / "recomp_dispatch.c"
    if not header.is_file() or not dispatch.is_file():
        raise SystemExit("Generated function header or dispatch table is missing.")

    header_text = read_text(header)
    dispatch_text = read_text(dispatch)
    if public not in header_text and generic not in header_text:
        raise SystemExit(f"Debug entry function {generic} was not emitted into recomp_funcs.h.")
    if public not in dispatch_text and generic not in dispatch_text:
        raise SystemExit(f"Debug entry function {generic} was not emitted into recomp_dispatch.c.")

    # Keep the small entrypoint files normalized before scanning implementations.
    if generic in header_text:
        header.write_text(header_text.replace(generic, public), encoding="utf-8", newline="")
    if generic in dispatch_text:
        dispatch.write_text(dispatch_text.replace(generic, public), encoding="utf-8", newline="")

    source_root = repo_root / "ports" / "mercenaries" / "src"
    source_files = sorted(
        path for suffix in ("*.c", "*.cpp", "*.h")
        for path in source_root.rglob(suffix)
        if generated_root not in path.parents
    )
    if not source_files:
        raise SystemExit(f"No maintained C/C++ source files found under {source_root}.")

    referenced: set[str] = set()
    local_definitions: set[str] = set()
    generic_definition_pattern = re.compile(
        FUNCTION_DEFINITION_PREFIX + r"(sub_[0-9A-Fa-f]{8})" +
        FUNCTION_DEFINITION_SUFFIX
    )
    print(f"[INFO] Scanning maintained source files: {len(source_files)}", flush=True)
    for index, path in enumerate(source_files, 1):
        masked = mask_comments_and_literals(read_text(path))
        referenced.update(SYMBOL_RE.findall(masked))
        local_definitions.update(generic_definition_pattern.findall(masked))
        if index == len(source_files) or index % 25 == 0:
            print(f"[INFO] Maintained source scan: {index}/{len(source_files)}", flush=True)

    missing = referenced - local_definitions
    stub_path = generated_root / "recomp_debug_retail_compat_stubs.c"

    generated_c_files = sorted(generated_root.glob("recomp_*.c"))
    generated_pattern = definition_pattern(missing)
    found_generated: set[str] = set()

    print(
        f"[INFO] Scanning generated C files: {len(generated_c_files)}; "
        f"candidate unresolved symbols: {len(missing)}",
        flush=True,
    )
    for index, path in enumerate(generated_c_files, 1):
        if path.resolve() == stub_path.resolve():
            continue  # Never let our own old stubs mask recalculation.
        text = read_text(path)
        # Normalize the generic debug entry in the generated implementation
        # during this same file read, instead of making another full-tree pass.
        if generic in text:
            text = text.replace(generic, public)
            path.write_text(text, encoding="utf-8", newline="")
        if generated_pattern is not None:
            found_generated.update(function_definitions(text, generated_pattern))
            missing.difference_update(found_generated)
            if not missing:
                generated_pattern = None
        if index == len(generated_c_files) or index % 4 == 0:
            print(f"[INFO] Generated C scan: {index}/{len(generated_c_files)}", flush=True)

    # Header prototypes do not count as implementations. Only source or
    # generated C bodies are subtracted from references.
    if missing:
        lines = [
            "/* Debug-XBE compatibility fallbacks for retail-only guest references.",
            " * These functions were referenced by maintained port code but had no",
            " * implementation in the debug XBE generated C. They are link-only",
            " * fallbacks; they do not recreate the original retail functionality. */",
            '#include "recomp_types.h"',
            "#include <stdint.h>",
            "extern uint32_t g_esp;",
            "",
        ]
        for name in sorted(missing):
            lines.append(f"void {name}(void) {{ g_esp += 4u; }}")
        stub_path.write_text("\n".join(lines) + "\n", encoding="utf-8", newline="")
        emitted = function_definitions(read_text(stub_path), definition_pattern(missing))
        still_missing = sorted(missing - emitted)
        if still_missing:
            raise SystemExit("Failed to emit compatibility definitions: " + ", ".join(still_missing))
        print(
            f"[INFO] Added {len(missing)} link-only compatibility stubs for retail-only references.",
            flush=True,
        )
        print("[INFO] Stubbed symbols: " + ", ".join(sorted(missing)), flush=True)
    elif stub_path.exists():
        stub_path.unlink()
        print("[INFO] Removed obsolete debug retail compatibility stub file.", flush=True)
    else:
        print("[OK] No missing retail-only function definitions were found.", flush=True)

    # Confirm normalization in the two small dispatch metadata files.
    if public not in read_text(header) or public not in read_text(dispatch):
        raise SystemExit("xbe_entry_point is missing after debug entry normalization.")
    print(f"[OK] Debug entry point 0x{entry:08X} is exported as xbe_entry_point.", flush=True)
    print("[OK] Retail Patch-Generated.py was intentionally not run on the debug XBE.", flush=True)


if __name__ == "__main__":
    main()
