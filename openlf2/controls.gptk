# OpenLF2 gptokeyb2 configuration
# Little Fighter 2 default keyboard controls:
#   Attack = A, Jump = J, Defend = D, Move = Arrow keys

# --- Action buttons ---
a = a          # Attack (A gomb a támadás)
b = j          # Jump (B gomb az ugrás)
x = d          # Defend (X gomb a védekezés)
y = y          # Unused

# --- D-Pad (movement) ---
up = up
down = down
left = left
right = right

# --- Left analog stick (also movement, with key repeat) ---
left_analog_up = up
left_analog_up = repeat
left_analog_down = down
left_analog_down = repeat
left_analog_left = left
left_analog_left = repeat
left_analog_right = right
left_analog_right = repeat

# --- Right analog stick = mouse movement ---
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

# --- Mouse tuning ---
mouse_scale = 8192
mouse_delay = 16
deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16

# --- Optional: slow mouse with L1 ---
l1 = mouse_slow
mouse_slow_scale = 50

# --- Hotkey + button extra assignments (optional) ---
# a_hk = enter
# b_hk = esc